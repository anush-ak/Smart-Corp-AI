# SmartCorp AI — frontend environment
#
# Copy to `.env.local` and adjust. All values are optional: the defaults run the
# full product against the bundled mock adapter.

# Base URL of the Django REST API. The dev server proxies `/api` to
# VITE_API_PROXY_TARGET so the browser only ever talks to one origin.
VITE_API_BASE_URL=/api

# `true` (default) serves the in-memory mock adapter, so every screen is
# demonstrable before an endpoint exists. Set to `false` to hit the live API.
VITE_USE_MOCK_API=true

# Where the dev server proxies `/api` during development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
