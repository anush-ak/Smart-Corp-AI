# SmartCorp AI — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
#
# AI provider: Google Gemini. The key lives ONLY on the backend (env var) and
# must never appear in frontend code, logs, screenshots or API responses.

DJANGO_SECRET_KEY=replace_me_with_a_long_random_string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Examples:
#   sqlite:///db.sqlite3                                  (local development)
#   postgres://smartcorp:secret@127.0.0.1:5432/smartcorp  (production / Docker)
DATABASE_URL=sqlite:///db.sqlite3

# Optional locally (caching, throttling, Celery). Required in production.
REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Google Gemini (backend only) ---
GOOGLE_API_KEY=replace_me
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_EMBEDDING_MODEL=text-embedding-004

# --- Email (console backend prints mail locally) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SmartCorp AI <no-reply@smartcorp.example>

# --- Demo endpoints (development / classroom demos only) ---
SMARTCORP_DEMO_PASSWORD=ChangeMe123!
DEMO_ENDPOINTS_ENABLED=True
ENABLE_API_DOCS=True
